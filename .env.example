# ============================================
# VICLAW ENVIRONMENT CONFIGURATION
# ============================================
# Set ONE provider below. Viclaw auto-detects which to use.
# Get your API key from the provider's website.
# Viclaw doesn't handle billing — you pay the provider directly.
# ============================================

# ── AI Provider (pick ONE) ──────────────────

# Ollama (FREE - runs locally, no key needed)
# Download: https://ollama.com
# Then run: ollama pull llama3.1
OLLAMA_HOST=http://localhost:11434

# Anthropic (Claude models)
# Get key: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI (GPT models)
# Get key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# OpenRouter (200+ models from one key, some free)
# Get key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# Google Gemini (free tier available)
# Get key: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# ── Optional Settings ───────────────────────

# Web search (for /research command)
# EXA_API_KEY=...
# TAVILY_API_KEY=...

# Channels (messaging platforms)
# TELEGRAM_BOT_TOKEN=...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=...

# Voice
# TTS_PROVIDER=edge-tts
# TTS_VOICE=en-US-AriaNeural

# ── Free stack ($0 inference) ─────────────
# One switch: every turn tries Ollama → Gemini free → OpenRouter :free.
# See docs/FREE-STACK.md for hardware tiers, limits, and ToS warnings.
# VICLAW_FREE_STACK=true
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3-coder:8b
# GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_FREE_MODEL=openrouter/free

# Gateway (WebSocket remote access)
# The gateway runs agent commands (shell, file writes). If its port is
# reachable beyond localhost, a token is mandatory — otherwise anyone on the
# network can run commands. Generate one: openssl rand -hex 32
# GATEWAY_TOKEN=change-me-to-a-long-random-secret
# GATEWAY_HOST=localhost
# GATEWAY_PORT=8080

# Sandbox (isolate shell commands)
# ENABLE_SANDBOX=true
# SANDBOX_TYPE=docker

# Logging
# LOG_LEVEL=info
