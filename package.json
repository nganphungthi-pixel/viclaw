{
  "name": "viclaw",
  "version": "1.0.0",
  "description": "AI coding agent that runs on your machine",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "viclaw": "./dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers/mod.d.ts",
      "import": "./dist/providers/mod.js"
    },
    "./tools": {
      "types": "./dist/tools/mod.d.ts",
      "import": "./dist/tools/mod.js"
    }
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js",
    "serve": "tsx src/gateway/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "setup": "node scripts/setup-wizard.js",
    "channels:start": "tsx src/channels/manager.ts",
    "voice:synthesize": "tsx src/voice/cli.ts",
    "security:scan": "tsx src/security/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.500.0",
    "@google/generative-ai": "^0.2.1",
    "@slack/bolt": "^3.17.0",
    "commander": "^11.1.0",
    "discord.js": "^14.14.0",
    "dotenv": "^16.4.1",
    "edge-tts": "^1.0.0",
    "ink": "^4.4.1",
    "node-telegram-bot-api": "^0.64.0",
    "openai": "^4.28.0",
    "playwright": "^1.41.0",
    "react": "^18.2.0",
    "sql.js": "^1.10.2",
    "ws": "^8.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/node-telegram-bot-api": "^0.64.3",
    "@types/react": "^18.2.48",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.5.10",
    "eslint": "^10.12.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.71.1",
    "prettier": "^3.9.9",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "coding",
    "claude",
    "cli"
  ],
  "author": "viclaw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nganphungthi-pixel/viclaw.git"
  },
  "homepage": "https://github.com/nganphungthi-pixel/viclaw#readme",
  "bugs": {
    "url": "https://github.com/nganphungthi-pixel/viclaw/issues"
  }
}
